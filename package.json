{
  "name": "@dale/ui",
  "version": "0.1.0",
  "description": "Dale Design System — tokens, React components and Tailwind theme for the Dale admin.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./tailwind/theme.css": "./tailwind/theme.css",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "styles",
    "tokens",
    "tailwind",
    "fonts",
    "assets",
    "docs",
    "templates",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && vite build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
